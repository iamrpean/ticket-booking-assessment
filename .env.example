# Salin jadi .env lalu sesuaikan. Semua opsional, sudah ada default-nya.
# docker compose otomatis membaca file .env di folder ini.
# Untuk `go run` tanpa container: set -a; source .env; set +a

# Port di sisi host (dipakai docker compose untuk mapping port)
PORT=8080
MOCK_PORT=9090
DB_PORT=5432

# Koneksi database (dipakai saat run tanpa container: go run ./cmd/server)
DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticket?sslmode=disable

# Mock accounting: berapa kali membalas 500 per kiriman sebelum sukses
MOCK_FAIL_FIRST=2

# Endpoint accounting pihak ketiga (default: mock lokal di MOCK_PORT)
# ACCOUNTING_URL=http://localhost:9090/transaction

# Postgres khusus test (dipakai go test, default localhost:5432)
# TEST_DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticket?sslmode=disable
